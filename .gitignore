.env
config/config.yaml
logs/
out/
__pycache__/
*.pyc
.venv/

# Evaluation output is generated. The three runs the documentation cites are kept
# as evidence; everything else is reproducible with the runners in eval/.
eval/results/*
!eval/results/eval-20260908-165453.json
!eval/results/baseline-plain-llm-20260911-174019.json
!eval/results/baseline-plain-llm-20260911-174126.json
!eval/results/stability-20260913-132723.json

# Real CVs carry personal data and never enter the repository.
samples/real_local/

# Author-facing material never enters this repository. These files are written for
# the author to read while presenting, not for anyone reading the project. Blocked
# by name as well as by living outside the repo root, so copying one in by mistake
# still does nothing.
VIDEO_SCRIPT*
DEMO_SCRIPT*
MY_BRIEFING*
RECREATE*
docs/VIDEO_SCRIPT*
docs/DEMO_SCRIPT*
docs/MY_BRIEFING*
docs/RECREATE*

# Recordings live in GitHub Releases, never in the repo. A 100 MB per-file limit
# applies to commits and video would bloat history for everyone cloning.
*.mp4
*.mkv
*.webm
